# ============================================
# MEDORA - Environment Configuration
# One Patient. One Permanent ID. A Complete Medical Journey.
# ============================================

# Application
APP_NAME=MEDORA
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-64-char-cryptographically-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Primary: PostgreSQL; Local fallback SQLite for zero-config dev if PostgreSQL not installed)
# PostgreSQL format: postgresql+psycopg://medora_user:medora_password@localhost:5432/medora_db
DATABASE_URL=postgresql+psycopg://medora:medora_password@localhost:5432/medora

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# AI Summarization (Google Gemini API)
# Leave empty to use MEDORA's clearly labelled Deterministic Clinical NLP Fallback Mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Voice Recognition & TTS Providers (Optional Cloud Providers; Browser Web Speech ta-IN/en-IN works out of the box)
VOICE_PROVIDER=auto
# Options: auto | google_cloud | azure | browser_webspeech
GOOGLE_CLOUD_SPEECH_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# Frontend Vite API Base URL (create frontend/.env if overriding)
VITE_API_BASE_URL=http://localhost:8000/api
